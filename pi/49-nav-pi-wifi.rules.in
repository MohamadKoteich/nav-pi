// nav-pi: let the navd service (user @USER@, no login session) manage Wi-Fi through NetworkManager.
// Installed by scripts/20-setup-pi.sh and 22-update-app.sh (the wifi feature). Only the actions nmcli needs for
// scan / connect / forget / radio on-off; nothing else (no hostname, DNS, or system-wide changes).
polkit.addRule(function(action, subject) {
  var ok = [
    "org.freedesktop.NetworkManager.wifi.scan",
    "org.freedesktop.NetworkManager.enable-disable-wifi",
    "org.freedesktop.NetworkManager.network-control",
    "org.freedesktop.NetworkManager.settings.modify.system",
    "org.freedesktop.NetworkManager.settings.modify.own"
  ];
  if (subject.user == "@USER@" && ok.indexOf(action.id) >= 0) {
    return polkit.Result.YES;
  }
});
