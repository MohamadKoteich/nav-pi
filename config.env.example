# nav-pi settings. Copy to config.env and edit:  cp config.env.example config.env
# Every script reads config.env (or the file named by NAVPI_CONFIG=<file>, e.g. one file per region).
# Without config.env, the scripts use this example file.
# Any setting can also be given for one run on the command line; a non-empty value there wins:
#   REGION=germany bash scripts/11-build-map.sh
# Nothing here is a password. Details: docs/INSTALL.md and docs/DATA.md.

# Name of the Pi on the network (reachable as <PI_HOSTNAME>.local) and its login user.
PI_HOSTNAME=nav-pi
PI_USER=nav

# Public SSH key that may log in to the Pi (key-only, no password is ever set).
# Left empty: scripts/01-build-image.sh uses ~/.ssh/id_ed25519.pub and creates it if missing.
# "none": no key at all and SSH turned off (a device for someone else; only the self-contained disk
# can be set up that way, since the network setup needs SSH). See also scripts/24-lock-device.sh.
SSH_PUBKEY_FILE=

# Locale of the Pi.
TIMEZONE=Europe/Berlin
KEYBOARD_LAYOUT=de
# Language of the kiosk browser itself (Chromium --lang, e.g. de, en-GB). The app's own language is chosen on
# the device in Settings > System > Language.
BROWSER_LANG=de

# Raspberry Pi OS Lite 64-bit (Trixie) — pinned. Newer images also work if they carry the
# cloud-init files (user-data/network-config) on the boot partition (all images since 2025-11-24).
PIOS_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-10-06/2026-10-06-raspios-trixie-arm64-lite.img.xz

# Where the built images and the region data go. Free space needed on the build PC, including the offline
# bundle and Docker's copy of the routing engine: ~12 GB for Upper Bavaria, ~35 GB for Germany (more for the
# self-contained disk; see docs/INSTALL.md).
WORK_DIR=./work

# ---- region data (built on the build PC from public OpenStreetMap data, see docs/DATA.md) ----
# Region name (used in file names; the Pi serves whichever region 21-push-data.sh switched it to),
# its bounding box west,south,east,north (map cut, search index) and, optional, the exact map area as
# GeoJSON (regions/<name>.geojson), and the OpenStreetMap extract for the route graph (a URL or a local
# .osm.pbf file). A region is these four lines. Pick ONE preset (or your own: docs/DATA.md "Your own region"):
#
#   Upper Bavaria incl. Munich (default) — small and quick: map 0.5 GB, search 31 MB, routing 0.3 GB,
#   ~25 min for all three parts (measured 2026-11-23). 8 GB RAM recommended.
REGION=oberbayern
REGION_BBOX=10.7,47.3,13.1,49.1
REGION_POLYGON=
OSM_PBF=https://download.geofabrik.de/europe/germany/bayern/oberbayern-latest.osm.pbf
#
#   Germany — map 7.6 GiB, routing 4.9 GiB, search 0.5 GB. ~4.5 hours, mostly the route graph (measured
#   2026-11-23, see docs/DATA.md). 16 GB RAM recommended (the peak was not measured):
#   REGION=germany  REGION_BBOX=5.5,47.0,15.5,55.2  REGION_POLYGON=
#   OSM_PBF=https://download.geofabrik.de/europe/germany-latest.osm.pbf
#
#   Europe — map ~48 GB, routing ~34 GB: the route graph cannot be built on a normal PC (it needs far
#   more RAM); only with an existing Europe graph (ROUTING_FROM_TILES + ROUTING_WHOLE_GRAPH=1):
#   REGION=europe  REGION_BBOX=-32,32,47,79  REGION_POLYGON=regions/europe.geojson
#   OSM_PBF=https://download.geofabrik.de/europe-latest.osm.pbf
#
# Valhalla image, pinned by digest; the SAME image runs on the Pi (it is multi-arch amd64+arm64),
# so the route graph built here is always readable there.
VALHALLA_IMAGE=ghcr.io/gis-ops/docker-valhalla/valhalla@sha256:d154396aa2499f463f3d5419ef3f107063247a4ffbed80dbcdf952aa53172d97
# The arm64 image's own ID (its config digest), which the Pi checks after loading it. The default is set in
# scripts/common.sh. Change it TOGETHER with VALHALLA_IMAGE, then fetch the Pi's copy again
# (bash scripts/00-get-bundle.sh pi-docker) and rebuild the route graph with the new image.
# VALHALLA_IMAGE_ID_ARM64=sha256:a8c22df311f277c4866b3ba9de771c4675ec4ed50a5d1cc1d145ee3bf62530dd
# Cut the route graph out of a bigger existing graph instead of building it (30 s instead of hours):
# the valhalla_tiles directory of that graph. Must be built with the same VALHALLA_IMAGE version.
ROUTING_FROM_TILES=
# 1 = use that whole graph (copy its valhalla_tiles.tar) instead of cutting REGION_BBOX out of it.
ROUTING_WHOLE_GRAPH=0
# CPU threads for the route graph build (16 GB RAM recommended for Germany) and processes for the search, along-route
# and driver-alert builders.
BUILD_THREADS=4
# Planet vector map (Protomaps basemap v4, .pmtiles): "latest" (the newest daily build, resolved when the
# map is cut), a URL (https://build.protomaps.com/<YYYYMMDD>.pmtiles — only recent builds stay online,
# see https://maps.protomaps.com/builds) or a local file. The cut reads only the needed parts over HTTP.
PMTILES_SRC=latest
# Most detailed zoom level of the map cut (15 = full detail).
MAP_MAXZOOM=15
# Parallel downloads for the map cut: 4 is fine for a country; keep 1 for Europe (each holds a range in RAM).
MAP_DOWNLOAD_THREADS=1
# Official pmtiles tool, pinned (version + sha256 of the release archives).
PMTILES_VERSION=1.31.2
PMTILES_SHA256_X86_64=3ed7dbf4ec2e6dfe5e25b6f70d1ffc932729f93c86db353bf514dd71010a312f
PMTILES_SHA256_ARM64=f8bd47e7ea866863489cad588fbaf2f31f42e5821f7a03f009b3769f05801cb1
# Map label fonts (glyph .pbf folders): a folder containing "Noto Sans Regular/".
# Empty = offline/data/fonts (scripts/00-get-bundle.sh fonts downloads them). Only scripts/21-push-data.sh
# reads this; the self-contained disk (scripts/40-make-disk.sh) always takes offline/data/fonts.
FONTS_DIR=

# ---- editions (see editions/ and hardware/) ----
# Which edition to install: basic | audio | advanced | full. Empty = the default of the board's
# hardware profile (detected from the Pi's model and RAM). FORCE_EDITION=1 ignores the board limit (not on a
# self-contained disk: there, EDITION is written onto the disk and must fit the board).
EDITION=
# Force a hardware profile (file name in hardware/ without .conf, e.g. 50-rpi5-8gb). Empty = auto-detect
# from the Pi's model and RAM (see hardware/README.md).
HARDWARE=
